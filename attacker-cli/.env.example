# Attacker CLI settings (all optional).
# You normally do NOT need to edit this file: run START_ATTACKER.bat (or
# `npm run dev`) and type the defender IP when asked. The CLI saves it here.
#
# The defender console shows the IP to use under "Attacker Connection".
# ATTACKER_SERVER_URL=http://192.168.43.12:3000

# Shared demo session (the defender uses this by default).
ATTACKER_SESSION_ID=SAFECUT-DEMO
ATTACKER_SESSION_TOKEN=safecut-demo-token
