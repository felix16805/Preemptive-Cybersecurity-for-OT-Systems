# ==============================================================================
# SafeCut OT Cybersecurity Platform — Environment Configuration
# ==============================================================================
# Copy this file to .env.local and populate with your environment credentials.
# Do NOT commit .env.local to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (REQUIRED for incident logging & audit trail)
# ------------------------------------------------------------------------------
# Public URL for your Supabase project (used by both client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous API Key (used for client-side reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-Side Service Role Key (REQUIRED for secure backend API & webhook writes)
# WARNING: Keep this secret! Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 2. Neo4j Graph Database (OPTIONAL — for live dynamic OT topology persistence)
# ------------------------------------------------------------------------------
# Bolt connection URI (local instance or Neo4j Aura cloud)
NEO4J_URI=bolt://localhost:7687

# Neo4j authentication credentials
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ------------------------------------------------------------------------------
# 3. SMTP Email Alerts via Nodemailer (OPTIONAL — for cyber incident notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_alerts_sender@example.com
SMTP_PASS=your_smtp_app_password
ALERT_TO=security_operations_center@example.com

# ------------------------------------------------------------------------------
# 4. Upstash Redis (OPTIONAL — for webhook rate limiting)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token