# ─────────────────────────────────────────────────────────────────────────────
#  SafeCut — environment configuration
#  Everything here is OPTIONAL. With no file at all the app runs fully from
#  in-memory state (graceful fallback), which is what you want for a live demo.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared demo session ──
# ON by default (no file needed): /api/session always hands out ONE fixed shared
# session, so the console, attacker CLI and Python bridge pair with zero setup.
# Set to 0 for the secure random-session flow.
SAFECUT_DEMO_MODE=1
# SAFECUT_DEMO_SESSION_ID=SAFECUT-DEMO
# SAFECUT_DEMO_TOKEN=safecut-demo-token

# ── Neo4j (optional — topology graph store) ──
# NEO4J_URI=bolt://localhost:7687          # or neo4j+s://xxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password

# ── Supabase (optional — incident log store) ──
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# ── Nodemailer (optional — email alert on response) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# ALERT_TO=recipient@email.com

# ─────────────────────────────────────────────────────────────────────────────
#  Attacker CLI settings live in attacker-cli/.env (not here). See DEMO_STEPS.txt.
# ─────────────────────────────────────────────────────────────────────────────
